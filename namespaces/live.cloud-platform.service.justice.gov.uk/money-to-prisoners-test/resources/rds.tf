# generated by https://github.com/ministryofjustice/money-to-prisoners-deploy
# Data Hub security group, shared by all DPS databases, which lets the Data Hub reach this database
# https://dsdmoj.atlassian.net/wiki/spaces/DPR/pages/4461494352
data "aws_security_group" "mp_dps_sg" {
  name = var.mp_dps_sg_name
}

module "rds" {
  source = "github.com/ministryofjustice/cloud-platform-terraform-rds-instance?ref=9.2.0"

  providers = {
    aws = aws.london
  }

  vpc_name = var.vpc_name

  business_unit          = var.business_unit
  team_name              = var.team_name
  application            = var.application
  is_production          = var.is_production
  namespace              = var.namespace
  environment_name       = var.environment
  infrastructure_support = var.infrastructure_support

  rds_family           = "postgres18"
  db_engine            = "postgres"
  db_engine_version    = "18.6"
  db_instance_class    = "db.t4g.small"
  db_allocated_storage = 20
  db_name              = "mtp_api"

  allow_major_version_upgrade = false
  allow_minor_version_upgrade = false
  deletion_protection         = true

  # Settings for Data Hub ingestion. rds.logical_replication and shared_preload_libraries only take effect
  # after a restart, so the database must be restarted once this applies.
  db_parameter = local.data_hub_db_parameters

  vpc_security_group_ids = [data.aws_security_group.mp_dps_sg.id]

  enable_irsa = true
}

locals {
  data_hub_db_parameters = [
    {
      # Supplying db_parameter replaces the module's default, a single rds.force_ssl entry, so it is restated here.
      # pending-reboot rather than immediate, otherwise it shows as a change on every plan.
      name         = "rds.force_ssl"
      value        = "1"
      apply_method = "pending-reboot"
    },
    {
      name         = "rds.logical_replication"
      value        = "1"
      apply_method = "pending-reboot"
    },
    {
      # Replaces the engine default rather than adding to it, so pg_tle and pg_stat_statements are kept
      name         = "shared_preload_libraries"
      value        = "pg_tle,pg_stat_statements,pglogical"
      apply_method = "pending-reboot"
    },
    {
      name         = "max_wal_size"
      value        = "1024"
      apply_method = "immediate"
    },
    {
      name         = "wal_sender_timeout"
      value        = "0"
      apply_method = "immediate"
    },
    {
      name         = "max_slot_wal_keep_size"
      value        = "40000"
      apply_method = "immediate"
    },
  ]
}

resource "kubernetes_secret" "rds" {
  metadata {
    name      = "rds"
    namespace = var.namespace
  }

  data = {
    db_identifier         = module.rds.db_identifier
    resource_id           = module.rds.resource_id
    rds_instance_endpoint = module.rds.rds_instance_endpoint
    database_name         = module.rds.database_name
    database_username     = module.rds.database_username
    database_password     = module.rds.database_password
    rds_instance_address  = module.rds.rds_instance_address
    rds_instance_port     = module.rds.rds_instance_port
    irsa_policy_arn       = module.rds.irsa_policy_arn
  }
}
